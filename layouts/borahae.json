{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": {
    "image": "backgrounds/borahae-hearts.png",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "#4a2d6e"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "borahae-tokens",
          "type": "block",
          "size": {
            "px": 190
          },
          "min": 60,
          "content": {
            "mod": "borahae-tokens"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "#5b3f7a"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#a374db"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ],
  "theme": "borahae",
  "terminal_opacity": 0.55,
  "colors": {
    "chrome": "#22113a",
    "canvas": "#1a0c2c",
    "surface": "#2a1545",
    "popover": "#2e184c",
    "raised": "#341c55",
    "hover": "#3d2263",
    "selected": "#4e2d7d",
    "border": "#4a2d6e",
    "input": "#6b4a96",
    "foreground": "#efe6fb",
    "muted": "#cdb8ea",
    "dim": "#a48cc4",
    "accent": "#b388f0",
    "accent_foreground": "#1a0c2c",
    "solid": "#a374db",
    "solid_foreground": "#ffffff",
    "selection": "#4a2d6e",
    "working": "#d6b4fc",
    "done": "#9fe0b0",
    "blocked": "#ff9bb5",
    "idle": "#8f7aa8"
  }
}